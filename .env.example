# Convex + Clerk Auth
# Copy to .env.local and fill in values

# Public site URL (no trailing slash). Used for canonical URL, Open Graph, sitemap, and JSON-LD.
# Set in Vercel → Project → Settings → Environment Variables for Production (and Preview if needed).
# Example: https://cursor-buildathon-sv.vercel.app
VITE_SITE_URL=https://your-production-domain.example

# Convex: Run `pnpm convex dev` first to create `.env.local`, then get cloud URL from dashboard for production
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Local dev: `pnpm convex dev` writes VITE_CONVEX_URL=http://127.0.0.1:3210 to `.env.local` automatically.

# Clerk: From https://dashboard.clerk.com (API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# IMPORTANT: Convex dashboard (Settings → Environment Variables):
#   CLERK_JWT_ISSUER_DOMAIN = Clerk Frontend API URL from Integrations → Convex
#     (dev: https://verb-noun-00.clerk.accounts.dev — NOT the JWT template issuer)
#   ADMIN_EMAILS = your@email.com (comma-separated for /admin access)
#
# Hub allowlists — seed from Luma export at seed/luma.csv:
#   pnpm seed:luma              — dev Convex deployment
#   pnpm seed:luma:prod         — production (prompts for confirmation)
# Deploy Convex functions first: pnpm convex:deploy
# Then seed perk inventory:
#   pnpm seed:cursor / pnpm seed:cursor:prod     — Cursor referral links (seed/cursor.csv)
#   pnpm seed:devin / pnpm seed:devin:prod       — Devin API codes (seed/devin.csv)
#   pnpm seed:codex / pnpm seed:codex:prod           — $100 Codex credits links (seed/codex-credits.csv)
#   pnpm seed:codex-api / pnpm seed:codex-api:prod   — OpenAI API codes (seed/codex-api.csv)
#
# Clerk session token claims (required for hub user bootstrap; set in dev AND prod):
#   Dashboard → Configure → Sessions → Customize session token → Claims
#   The Convex integration pre-maps aud. You must also add:
#     email  →  {{user.primary_email_address.email_address}}
#   Optional but recommended:
#     name   →  {{user.full_name}}
#     picture → {{user.image_url}}
#   After saving claims: sign out completely and sign back in.
#
# Clerk email OTP (single auth method; set in dev AND prod):
#   Dashboard → User & Authentication → Email, Phone, Username
#     - Enable Email address
#     - Enable Email verification code (OTP)
#     - Disable Email verification link (optional — OTP only)
#   Dashboard → Social connections — disable Google, GitHub, and all OAuth providers.
#   First-time and returning users share the same Clerk modal (no separate sign-up flow).
#   Dev testing: Clerk test mode accepts code 424242 (real emails often not sent in dev).
#   Prod: Clerk sends OTP emails via its ESP; configure DNS on your domain in Clerk Dashboard.
#   Dashboard → Paths → Allowed redirect URLs — add:
#     - http://localhost:5173  (or your Vite dev port)
#     - VITE_SITE_URL value for production (and preview URLs if used)
#
# Legacy note: a manual JWT template named "convex" also works if you are NOT using
# the Clerk ↔ Convex integration — prefer the integration flow above.
#
# Cloudflare R2 (Convex dashboard only — used for hub + /submit media uploads):
#   R2_ACCOUNT_ID = <Cloudflare account ID>
#   R2_ACCESS_KEY_ID = <R2 API token access key>
#   R2_SECRET_ACCESS_KEY = <R2 API token secret>
#   R2_BUCKET_NAME = cursor-hack-sv-uploads
#   R2_PUBLIC_BASE_URL = https://pub-xxxx.r2.dev  (or custom domain with public read)
#   R2_UPLOAD_PREFIX = uploads/  (optional; default uploads/)
#
# GitHub / GitLab (Convex dashboard only — hub repo URL validation):
#   GITHUB_TOKEN = ghp_...  (optional; raises GitHub API rate limits)
#   GITLAB_TOKEN = glpat-...  (optional; for GitLab API rate limits / private access)