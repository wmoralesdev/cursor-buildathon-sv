# Copy to `.env.local` and fill in values.
# Run `pnpm convex dev` once — it writes CONVEX_DEPLOYMENT and VITE_CONVEX_URL for local dev.

# =============================================================================
# Site (Vite — set in Vercel for production/preview builds)
# =============================================================================
# Public URL, no trailing slash. Used for canonical links, Open Graph, sitemap, and JSON-LD.

VITE_SITE_URL=https://your-production-domain.example

# =============================================================================
# Convex (Vite client)
# =============================================================================
# Local dev: `pnpm convex dev` sets VITE_CONVEX_URL=http://127.0.0.1:3210 automatically.
# Production: deployment URL from https://dashboard.convex.dev

VITE_CONVEX_URL=https://your-deployment.convex.cloud

# =============================================================================
# Clerk (Vite client — https://dashboard.clerk.com → API Keys)
# =============================================================================

VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# =============================================================================
# Convex dashboard only (Settings → Environment Variables)
# =============================================================================
# Do not put these in `.env.local`. Set per deployment at https://dashboard.convex.dev
# (dev and prod). Clerk Issuer: Dashboard → JWT Templates → "convex" → Issuer URL.

# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer.example
# ADMIN_EMAILS=you@example.com,teammate@example.com

# Cloudflare R2 — presigned uploads for builder hub and /submit media
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=cursor-hack-sv-uploads
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# R2_UPLOAD_PREFIX=uploads/
