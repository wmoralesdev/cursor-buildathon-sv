# syntax=docker/dockerfile:1.7

# ──────────────────────────────────────────────────────────────────────────────
# Stage 1: bundle the Remotion entry from the parent monorepo.
# Build context is the repo root so we can copy `src/`.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS bundle

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
COPY tsconfig*.json ./
COPY remotion.config.ts ./
COPY src ./src

RUN pnpm install --frozen-lockfile=false --prod=false

RUN pnpm exec remotion bundle src/remotion/index.ts /workspace/bundle

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2: Node + Chromium runtime that runs the render server.
# Base image bundles a Chromium build compatible with @remotion/renderer.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV REMOTION_BUNDLE_DIR=/app/bundle
ENV PORT=8080

# Chromium runtime + ffmpeg deps required by @remotion/renderer for headless renders.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    fonts-noto-color-emoji \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxshmfence1 \
    libxss1 \
    libxtst6 \
    wget \
    xdg-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY render-worker/container/package.json render-worker/container/tsconfig.json ./
RUN npm install --omit=dev=false --no-audit --no-fund

COPY render-worker/container/src ./src
RUN npx tsc -p tsconfig.json

# Bring over the pre-built Remotion bundle from the previous stage.
COPY --from=bundle /workspace/bundle /app/bundle

# Pre-pull the Chromium build that @remotion/renderer expects so cold-starts
# do not incur a download.
RUN node -e "require('@remotion/renderer').ensureBrowser()"

EXPOSE 8080
CMD ["node", "dist/server.js"]
